+struct RunawayConfig {
+    float minimum_speed, unconditional_speed, minimum_acceleration, acceleration_tau;
+    uint32_t confirm_ms;
+};
+// One trigger per stand-up. Signed confirmation rejects a single velocity
+// spike and alternating noise; a high steady speed also qualifies.
+class RunawayDetector {
+public:
+    void reset() { *this = RunawayDetector{}; }
+    float update(bool eligible, float velocity, float dt, const RunawayConfig& c) {
+        if (!std::isfinite(velocity) || !std::isfinite(dt) || dt <= 0 || dt > .1f) {
+            reset();
+            return 0;
+        }
+        const float acceleration = _initialized ? (velocity - _previous_velocity) / dt : 0;
+        _previous_velocity = velocity;
+        _initialized = true;
+        _acceleration += clamp(dt / c.acceleration_tau, 0, 1) * (acceleration - _acceleration);
+        if (_triggered) return 0;
+        const float direction = velocity > 0 ? 1.0f : -1.0f;
+        const float speed = std::fabs(velocity);
+        const bool growing = direction * _acceleration >= c.minimum_acceleration;
+        const bool candidate = eligible && speed >= c.minimum_speed
+                            && (growing || speed >= c.unconditional_speed);
+        if (!candidate) { _qualifying_ms = 0; _direction = 0; return 0; }
+        if (direction != _direction) { _qualifying_ms = 0; _direction = direction; }
+        _qualifying_ms += dt * 1000;
+        if (_qualifying_ms + .001f < c.confirm_ms) return 0;
+        _triggered = true;
+        return direction;
+    }
+private:
+    float _previous_velocity = 0, _acceleration = 0, _qualifying_ms = 0, _direction = 0;
+    bool _initialized = false, _triggered = false;
+};
+
+// A center-axis catch is added to the remaining tip-axis return. Intersect
+// both arms' permitted fractions so the combined motion stays inside the
+// envelope already used by tip-up and normal arm assistance.
+inline float limitArmAssist(float nominal_left, float nominal_right,
+                            float center_left, float center_right,
+                            float tip_left, float tip_right,
+                            float requested, float minimum, float maximum) {
+    float lo = minimum, hi = maximum;
+    const auto constrain = [&](float nominal, float center, float tip) {
+        const float lower = std::fmin(std::fmin(0.0f, tip), std::fmin(minimum * center, maximum * center));
+        const float upper = std::fmax(std::fmax(0.0f, tip), std::fmax(minimum * center, maximum * center));
+        if (std::fabs(center) < .00001f) return;
+        const float a = (lower - nominal) / center, b = (upper - nominal) / center;
+        lo = std::fmax(lo, std::fmin(a, b));
+        hi = std::fmin(hi, std::fmax(a, b));
+    };
+    constrain(nominal_left, center_left, tip_left);
+    constrain(nominal_right, center_right, tip_right);
+    return lo <= hi ? clamp(requested, lo, hi) : 0.0f;
+}
